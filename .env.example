# Database Connection
POSTGRES_URL=postgresql://user:password@localhost:5432/tracewise
POSTGRES_URL_NON_POOLING=postgresql://user:password@localhost:5432/tracewise

# Redis for Queue
REDIS_URL=redis://localhost:6379

# Encryption (generate with: openssl rand -hex 16)
ENCRYPTION_KEY=your_32_character_hex_string_here

# GitHub OAuth (optional, for auto-PR creation)
GITHUB_CLIENT_ID=your_github_app_id
GITHUB_CLIENT_SECRET=your_github_app_secret
NEXTAUTH_SECRET=your_nextauth_secret

# Email Alerts (Resend)
RESEND_API_KEY=re_your_resend_api_key

# Application URLs
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000

# LLM Providers (add as needed)
# OpenAI
OPENAI_API_KEY=sk_test_...

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Google
GOOGLE_API_KEY=AIzaSy...

# Groq
GROQ_API_KEY=gsk_...
