# Supabase Connection (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Get these from Supabase Dashboard:
# 1. Settings > API > Project URL (for NEXT_PUBLIC_SUPABASE_URL)
# 2. Settings > API > Project API Keys > anon (public) key (for NEXT_PUBLIC_SUPABASE_ANON_KEY)
# 3. Settings > API > Project API Keys > service_role (secret) key (for SUPABASE_SERVICE_ROLE_KEY)

# Redis for Queue (optional, for production background jobs)
REDIS_URL=redis://localhost:6379

# Encryption (generate with: openssl rand -hex 16)
ENCRYPTION_KEY=your_32_character_hex_string_here

# GitHub Configuration (optional)
GITHUB_TOKEN=ghp_your_personal_access_token
GITHUB_CLIENT_ID=your_github_app_id
GITHUB_CLIENT_SECRET=your_github_app_secret

# Authentication Secret (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=your_nextauth_secret_here

# Email Alerts (Resend - optional)
RESEND_API_KEY=re_your_resend_api_key

# Application URLs
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000

# LLM Providers (add at least one for AI analysis)
# OpenAI
OPENAI_API_KEY=sk_test_...

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini
GOOGLE_API_KEY=AIzaSy...

# Groq (Fast inference)
GROQ_API_KEY=gsk_...
