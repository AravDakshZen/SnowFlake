# ─────────────────────────────────────────────────────────────────────────────
# SnowFlake — Environment Variables
#
# The app is deployed at: https://snowflake-eessgdrsrdg.vercel.app
#
# IMPORTANT:
#   • Copy this file to `.env.local` for local development.
#   • EVERY variable below must ALSO exist in the Vercel project env vars
#     (Project Settings > Environment Variables) for the deployed app.
#     Missing vars are the #1 cause of broken Google/GitHub sign-in and
#     "redirect_uri mismatch" errors on Vercel.
#   • For local dev, the URL vars point at http://localhost:3000. On Vercel
#     they MUST point at the hosted URL.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase Auth + Database (required) ─────────────────────────────────────
# Create project at https://supabase.com → Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://vryrgjoxhanwkjaptilr.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZyeXJnam94aGFud2tqYXB0aWxyIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODU5NDQ5ODcsImV4cCI6MjEwMTUyMDk4N30.rxzTw09WbAtEeY6RwtyrGxnRlMHLre76YgAWW-Al5zM
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZyeXJnam94aGFud2tqYXB0aWxyIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4NTk0NDk4NywiZXhwIjoyMTAxNTIwOTg3fQ.QO8LkcBCtYFye_ZZQzVgQP7FS9fgZL6LRjb2JWeMPgw

# Google sign-in (Supabase side):
#   1. Supabase Dashboard → Authentication → Providers → Google → enable.
#   2. Google Cloud Console → OAuth → create credentials → add redirect URI:
#      https://vryrgjoxhanwkjaptilr.supabase.co/auth/v1/callback
#   3. Supabase Dashboard → Authentication → URL Configuration → Redirect URLs:
#      add https://snowflake-eessgdrsrdg.vercel.app/auth/callback (and
#      http://localhost:3000/auth/callback for local dev).
#   4. Put the Google Client ID / Secret in Supabase (NOT in this file).

# ── Direct Postgres connection (REQUIRED — the app's data layer) ─────────────
# Get the connection strings from Supabase Dashboard > Project Settings > Database.
#   POSTGRES_URL             = "Transaction pool" / pooled connection (normal queries)
#   POSTGRES_URL_NON_POOLING = "Direct connection" / session pooler (migrations / DDL)
POSTGRES_URL=postgresql://postgres.vryrjoxwkjaptilr:YOUR_DB_PASSWORD@aws-0-<region>.pooler.supabase.com:5432/postgres
POSTGRES_URL_NON_POOLING=postgresql://postgres.vryrjoxwkjaptilr:YOUR_DB_PASSWORD@db.<region>.supabase.com:5432/postgres
POSTGRES_PRISMA_URL=

# ── Redis for the queue (required for background investigation jobs) ─────────
# Production: use Upstash / Redis Cloud and set the full connection URL on Vercel.
REDIS_URL=redis://localhost:6379

# ── Encryption (generate with: openssl rand -hex 16) ─────────────────────────
ENCRYPTION_KEY=44c0a2b94f7caf82232a9ea8c20ae398

# ── GitHub Configuration (required for repo access / auto-PR) ───────────────
# Create a GitHub OAuth App: github.com/settings/developers → New OAuth App.
# Set the Authorization callback URL to:
#   https://snowflake-eessgdrsrdg.vercel.app/api/github/callback
# (and http://localhost:3000/api/github/callback for local dev).
GITHUB_TOKEN=ghp_your_personal_access_token
GITHUB_CLIENT_ID=your_github_app_id
GITHUB_CLIENT_SECRET=your_github_app_secret

# Optional override for the GitHub OAuth redirect URI. Must EXACTLY match the
# callback URL registered in the GitHub OAuth App, or GitHub rejects the login
# with "redirect_uri is not associated with this application".
# On Vercel set this to:
#   NEXT_PUBLIC_GITHUB_REDIRECT_URI=https://snowflake-eessgdrsrdg.vercel.app/api/github/callback
# For local dev set it to http://localhost:3000/api/github/callback
NEXT_PUBLIC_GITHUB_REDIRECT_URI= 

# ── Authentication secret (generate with: openssl rand -base64 32) ───────────
NEXTAUTH_SECRET=tg++oXRFdjwY/VeVI5omVR9jQWMgqurP8bLnfsIX0aE=

# ── Email alerts (Resend — optional) ────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key

# ── Application URLs ─────────────────────────────────────────────────────────
# ⚠️  On Vercel these MUST be the hosted URL, or OAuth breaks:
#       NEXTAUTH_URL=https://snowflake-eessgdrsrdg.vercel.app
#       NEXT_PUBLIC_APP_URL=https://snowflake-eessgdrsrdg.vercel.app
#       NEXT_PUBLIC_SOCKET_URL=https://snowflake-eessgdrsrdg.vercel.app
#    For local dev, use http://localhost:3000.
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000

# Optional override for the Supabase OAuth callback in local dev only.
# If unset, the app uses {origin}/auth/callback automatically.
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=

# ── LLM providers (add at least one for AI analysis) ────────────────────────
OPENAI_API_KEY=sk_test_...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AQ.Ab8RN6KC3VXbWXYk0sEXvHWfnE1Ck9S1E3C0Djiv8Wh51AJufg
